  author = {Short, Cassie Ann and Breznau, Nate and Bruntsch, Maria and Burkhardt, Micha and Busch, Niko A. and Cesnaite, Elena and Frank, Maximilian and Gießing, Carsten and Krähmer, Daniel and Kristanto, Daniel and Lonsdorf, Tina and Neuendorf, Claudia and Nguyen, Hung H. V. and Rausch, Manuel and Schmalz, Xenia and Schneck, Andreas and Tabakci, Cem and Hildebrandt, Andrea},
