# systemd user service for auto-committing Zotero-synced BibTeX changes.
#
# DO NOT edit this file directly. Run scripts/install-bib-watcher.sh instead,
# which fills in the correct paths and installs it for you.
#
# To install manually, copy to ~/.config/systemd/user/ after substituting
# REPO_ROOT and BIB_REL_PATH.

[Unit]
Description=Auto-commit Zotero BibTeX — cienciasocialabierta2026
Documentation=file://REPO_ROOT/scripts/auto-commit-bib.sh
After=network.target

[Service]
Type=simple
WorkingDirectory=REPO_ROOT
ExecStart=REPO_ROOT/scripts/auto-commit-bib.sh BIB_REL_PATH
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Give Zotero time to finish syncing before the script starts at boot
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=default.target
